# We include setups for
#	OSGi-Test Support - gecko-osgitest
#	DIMC Github-Configuration - gecko-dimc
#	Jacoco Support - gecko-jacoco
-library: \
	geckoDIMC,\
	geckoOSGi-Test,\
	geckoJacoco,\
	geckoEMF,\
	geckoEMFUtil

# Needed because we enabled library 'gecko-dimc'
# Activate baselining
dimcBaselining: false
github-group: geckoprojects-org
github-project: org.gecko.emf.sensinact
base-version: 1.0.0
mavenCentral: true

sensinact.version: 0.0.2-SNAPSHOT

# Maven Central Group-Id
# For Geckoprojects the groupid must start with org.geckoprojects
-groupid: org.geckoprojects.sensinact

javac.source: 21
javac.target: 21

-require-bnd "(version>=7.1.0)"

-plugin.2.Central: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        snapshotUrl="https://devel.data-in-motion.biz/nexus/repository/dim-snapshot/,https://oss.sonatype.org/content/repositories/snapshots/"; \
        releaseUrl=https://repo.maven.apache.org/maven2/; \
        index=${.}/central.mvn; \
        readOnly=true; \
        poll.time=-1; \
        name="Central"
        
-plugin.3.sensinact: \
	aQute.bnd.repository.maven.provider.MavenBndRepository;\
		releaseUrl=https://repo.eclipse.org/content/repositories/sensinact-releases/;\
		snapshotUrl=https://repo.eclipse.org/content/repositories/sensinact-snapshots/;\
		index=${.}/sensinact.maven;\
		readOnly=true;\
        poll.time=10;\
		name="SensiNact SDK"

-plugin.4.Sonatype: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        snapshotUrl="https://central.sonatype.com/repository/maven-snapshots/"; \
        releaseUrl=https://repo.maven.apache.org/maven2/; \
        index=${.}/sonatype.mvn; \
        readOnly=true; \
        poll.time=-1; \
        name="Sonatype"

-plugin.0.Local: \
	aQute.bnd.deployer.repository.LocalIndexedRepo; \
		name = Local; \
		pretty = true; \
		local = ${build}/local

-plugin.1.Temp: \
	aQute.bnd.deployer.repository.LocalIndexedRepo; \
		name = Temp; \
		pretty = true; \
		local = ${build}/cache/temp
